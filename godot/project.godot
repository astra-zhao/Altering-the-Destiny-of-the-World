; Engine configuration file.
; 《改命：天下》v0.4 — Godot 4.6.3. Edit in the editor when possible.

config_version=5

[application]

config/name="改命：天下"
config/description="v0.4：v1.2 手绘界面。机制仍是 v0.3 的引导、帮我选和四轨 BGM。"
config/version="0.4.0"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/min_width=1100
window/size/min_height=680
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[autoload]

Campaign="*res://scripts/campaign_state.gd"
Bgm="*res://scripts/bgm.gd"
Fade="*res://scripts/screen_fade.gd"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[gui]

theme/custom="res://theme/main_theme.tres"

[editor_plugins]

enabled=PackedStringArray("res://addons/pack_filter/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0784314, 0.0666667, 0.054902, 1)
